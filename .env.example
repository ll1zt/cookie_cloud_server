# Optional. Enables decrypt-cache on /update and admin Bearer export on /get.
# Leave unset for pure ciphertext store (official CookieCloud compatible).
COOKIE_CLOUD_SERVER_PASSWORD=your-secret-password

# Listen port. Official CookieCloud uses 8088; this server defaults to 4000.
PORT=4000

# Optional path prefix, e.g. /cookie — matches upstream API_ROOT
# API_ROOT=

# CORS Access-Control-Allow-Origin value
# CORS_ORIGINS=*

# Rate limit: max requests per IP per window (0 disables)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Recommended Development Environment: data/cookie_cloud_server.db (relative to the project root directory)
# Recommended Production Environment: /app/data/cookie_cloud_server.db (container path)
DATABASE_PATH=data/cookie_cloud_server.db

# Elixir Node Secret (recommended to be changed to a random string for internal security)
RELEASE_COOKIE=cookie-secret-change-me
